  "rules": {
    "initialHand": 7,
    "drawOnInvalid": true,
    "drawEndsTurn": true,
    "stackDrawCards": false,
    "jumpIn": false,
    
    "validPlay": {
      "conditions": ["colorMatch", "valueMatch", "wildCard", "activeColorMatch"],
      "colorMatch": "card.color === topCard.color",
      "valueMatch": "card.value === topCard.value",
      "wildCard": "card.type === 'wild'",
      "activeColorMatch": "card.color === activeColor"
    },
    
    "cardEffects": {
      "skip": { 
        "action": "skipNextPlayer",
        "description": "Next player loses their turn"
      },
      "reverse": { 
        "action": "reverseDirection",
        "description": "Reverses play direction"
      },
      "draw2": { 
        "action": "nextPlayerDraws", 
        "amount": 2,
        "description": "Next player draws 2 and loses turn"
      },
      "wild": { 
        "action": "chooseColor",
        "description": "Choose any color to continue"
      },
      "wild_draw4": { 
        "action": "chooseColor", 
        "then": "nextPlayerDraws", 
        "amount": 4,
        "description": "Choose color and next player draws 4",
        "challengeable": true
      }
    },
    
    "winCondition": "player.hand.length === 0",
    
    "unoCall": {
      "trigger": "player.hand.length === 1",
      "mustCall": true,
      "penalty": {
        "forgotToCall": "drawCards",
        "amount": 2
      }
    },
    
    "scoring": {
      "numberCards": "faceValue",
      "actionCards": 20,
      "wildCards": 50
    }
  },
  
  "ui": {
    "cardColors": {
      "red": "#ef4444",
      "yellow": "#fbbf24",
      "green": "#22c55e",
      "blue": "#3b82f6",
      "wild": "linear-gradient(135deg, #8b5cf6, #ec4899, #f59e0b, #22c55e)"
    },
    "specialActions": [
      {
        "id": "uno",
        "label": "UNO!",
        "trigger": "hand.length === 1",
        "style": "danger"
      }
    ]
  },
  
  "ai": {
    "difficulty": "normal",
    "strategies": [
      "Play matching color/number when possible",
      "Save wild cards for difficult situations",
      "Use +2/+4 strategically when opponent is low on cards",
      "Call UNO when appropriate"
    ],
    "responseStyle": {
      "onPlay": ["*plays a {{card}}*", "*slaps down a {{card}}*", "*grins and plays {{card}}*"],
      "onDraw": ["*draws a card from the pile*", "*reluctantly draws*", "*takes a card*"],
      "onUno": ["UNO!", "*triumphantly* UNO!", "UNO! Just one card left~"],
      "onWin": ["*wins with a flourish*", "That's the game!", "*celebrates*"],
      "onLose": ["Good game!", "You got me this time!", "*gracefully accepts defeat*"]
    }
  }
}
